---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Hero from "../components/Hero.astro";
import HowItWorksNew from "../components/HowItWorksNew";
import ForBrandsNew from "../components/ForBrandsNew";
import ForPromotersNew from "../components/ForPromotersNew";
import FeaturesNew from "../components/FeaturesNew";
import CTAFinalNew from "../components/CTAFinalNew";
import FooterNew from "../components/FooterNew";
import HeroNew from "@/components/HeroNew.astro";
import HoneycombDivider from "@/components/HoneycombDivider.astro";
---

<Layout>
  <Navbar client:load />
  <main>
    <HeroNew />
    <HoneycombDivider
      seed={3}
      rows={3}
      class="bg-muted timeline-view animate-fade-in animate-range-[entry_5%_contain_10%]"
    />
    <HowItWorksNew client:load />
    <ForBrandsNew />
    <ForPromotersNew />
    <HoneycombDivider seed={5} class="reveal animate-fade-in bg-background" />
    <FeaturesNew />
    <HoneycombDivider seed={8} flip class="reveal animate-fade-in bg-background" />
    <CTAFinalNew />
  </main>
  <FooterNew />
</Layout>
