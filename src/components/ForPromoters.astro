---
import { Badge } from '@/components/ui/badge';
import { Card, CardContent } from '@/components/ui/card';
---

<section id="para-promotores" class="py-24 bg-muted">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-14" data-animate>
      <Badge variant="outline" className="h-auto text-xs font-semibold px-3 py-1 bg-primary/10 border-primary/20 text-primary">
        Para promotores freelance
      </Badge>
      <h2 class="mt-4 text-3xl sm:text-4xl font-bold text-foreground">
        Genera ingresos con total
        <span class="text-primary"> flexibilidad</span>
      </h2>
      <p class="mt-3 text-base text-muted-foreground max-w-lg mx-auto">
        Sé tu propio jefe. Acepta visitas cuando quieras y genera ingresos adicionales aprovechando tu tiempo libre.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

      <Card
        className="py-0 bg-card border border-border hover:border-primary/30 hover:shadow-sm transition-all duration-200 group"
        data-animate data-delay="0"
      >
        <CardContent className="p-7">
          <div class="w-11 h-11 bg-primary/10 rounded-xl flex items-center justify-center mb-5 group-hover:bg-primary/20 transition-colors">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-foreground mb-2">Total flexibilidad</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Tú decides cuándo y dónde trabajas. Acepta únicamente las visitas que se adapten a tu disponibilidad.
          </p>
        </CardContent>
      </Card>

      <!-- Highlighted card -->
      <Card
        className="py-0 bg-primary border-0 hover:opacity-95 transition-opacity duration-200"
        data-animate data-delay="150"
      >
        <CardContent className="p-7">
          <div class="w-11 h-11 bg-primary-foreground/15 rounded-xl flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-primary-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-primary-foreground mb-2">Ingresos adicionales</h3>
          <p class="text-sm text-primary-foreground/75 leading-relaxed">
            Cada visita completada se traduce en un pago directo. Aprovecha tu tiempo libre para generar dinero extra.
          </p>
        </CardContent>
      </Card>

      <Card
        className="py-0 bg-card border border-border hover:border-primary/30 hover:shadow-sm transition-all duration-200 group"
        data-animate data-delay="300"
      >
        <CardContent className="p-7">
          <div class="w-11 h-11 bg-primary/10 rounded-xl flex items-center justify-center mb-5 group-hover:bg-primary/20 transition-colors">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-foreground mb-2">Modelo bajo demanda</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Recibe notificaciones de visitas en tu área y elige las que mejor se adapten a ti. Sin compromisos fijos.
          </p>
        </CardContent>
      </Card>

    </div>
  </div>
</section>
