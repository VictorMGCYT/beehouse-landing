---
import { Badge } from '@/components/ui/badge';
import { Card, CardContent } from '@/components/ui/card';
import { cn } from '@/lib/utils';
import { buttonVariants } from '@/components/ui/button';
---

<section id="para-marcas" class="py-24 bg-background">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

      <!-- Left: copy -->
      <div data-animate>
        <Badge variant="outline" className="h-auto text-xs font-semibold px-3 py-1 bg-primary/10 border-primary/20 text-primary">
          Para marcas y negocios
        </Badge>
        <h2 class="mt-4 text-3xl sm:text-4xl font-bold text-foreground leading-tight">
          Maximiza tu presencia<br/>en cada
          <span class="text-primary"> punto de venta</span>
        </h2>
        <p class="mt-4 text-base text-muted-foreground leading-relaxed">
          BeeHouse te da el control total sobre la ejecución de tus actividades comerciales.
          Sabe exactamente qué pasa con tus productos en cada tienda, en tiempo real.
        </p>
        <a
          href="#contacto"
          class={cn(buttonVariants({ size: 'lg' }), 'mt-8 rounded-full inline-flex gap-2')}
        >
          Registra tu marca
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Right: benefit cards 2×2 -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">

        <Card className="py-0 bg-card border border-border hover:border-primary/30 hover:shadow-sm transition-all duration-200 group" data-animate data-delay="0">
          <CardContent className="p-5">
            <div class="w-9 h-9 bg-primary/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
              <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />
              </svg>
            </div>
            <h3 class="text-sm font-semibold text-foreground mb-1.5">Mayor cobertura</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">Amplía tu alcance en puntos de venta sin necesidad de una fuerza de ventas propia.</p>
          </CardContent>
        </Card>

        <Card className="py-0 bg-card border border-border hover:border-primary/30 hover:shadow-sm transition-all duration-200 group sm:mt-6" data-animate data-delay="100">
          <CardContent className="p-5">
            <div class="w-9 h-9 bg-primary/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
              <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </div>
            <h3 class="text-sm font-semibold text-foreground mb-1.5">Visibilidad total</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">Ve en tiempo real cómo se exhiben y posicionan tus productos en cada punto de venta.</p>
          </CardContent>
        </Card>

        <Card className="py-0 bg-card border border-border hover:border-primary/30 hover:shadow-sm transition-all duration-200 group" data-animate data-delay="200">
          <CardContent className="p-5">
            <div class="w-9 h-9 bg-primary/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
              <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
            </div>
            <h3 class="text-sm font-semibold text-foreground mb-1.5">Control de ejecución</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">Recibe reportes con fotos y evidencias de cada visita realizada para garantizar estándares.</p>
          </CardContent>
        </Card>

        <Card className="py-0 bg-card border border-border hover:border-primary/30 hover:shadow-sm transition-all duration-200 group sm:mt-6" data-animate data-delay="300">
          <CardContent className="p-5">
            <div class="w-9 h-9 bg-primary/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
              <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <h3 class="text-sm font-semibold text-foreground mb-1.5">Optimización continua</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">Analiza datos de ejecución para mejorar tu estrategia comercial de manera constante.</p>
          </CardContent>
        </Card>

      </div>
    </div>
  </div>
</section>
