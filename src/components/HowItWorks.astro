---
import { Badge } from '@/components/ui/badge';
import { Card, CardContent } from '@/components/ui/card';
---

<section id="como-funciona" class="py-24 bg-muted">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-16" data-animate>
      <Badge variant="outline" className="h-auto text-xs font-semibold px-3 py-1 bg-primary/10 border-primary/20 text-primary">
        Proceso simple
      </Badge>
      <h2 class="mt-4 text-3xl sm:text-4xl font-bold text-foreground">
        ¿Cómo funciona BeeHouse?
      </h2>
      <p class="mt-3 text-base text-muted-foreground max-w-xl mx-auto">
        En tres pasos conecta tu marca con promotores y lleva el control total de tus puntos de venta.
      </p>
    </div>

    <!-- Steps -->
    <div class="flex flex-col md:flex-row items-stretch gap-4 md:gap-0">

      <!-- Step 1 -->
      <Card
        className="flex-1 py-0 bg-card border border-border hover:border-primary/30 hover:shadow-sm transition-all duration-200"
        data-animate data-delay="0"
      >
        <CardContent className="flex flex-col items-center text-center p-8">
          <div class="relative w-14 h-14 bg-primary/10 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span class="absolute -top-2 -right-2 w-6 h-6 bg-primary text-primary-foreground text-xs font-bold rounded-full flex items-center justify-center">1</span>
          </div>
          <h3 class="text-base font-semibold text-foreground mb-2">Registra tu visita</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Define el punto de venta, fecha, horario y los requerimientos de la visita desde la plataforma.
          </p>
        </CardContent>
      </Card>

      <!-- Connector -->
      <div class="hidden md:flex items-center justify-center px-3 text-border flex-shrink-0" aria-hidden="true">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </div>
      <div class="flex md:hidden items-center justify-center text-border -my-1" aria-hidden="true">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
        </svg>
      </div>

      <!-- Step 2 -->
      <Card
        className="flex-1 py-0 bg-card border border-border hover:border-primary/30 hover:shadow-sm transition-all duration-200"
        data-animate data-delay="150"
      >
        <CardContent className="flex flex-col items-center text-center p-8">
          <div class="relative w-14 h-14 bg-primary/10 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="absolute -top-2 -right-2 w-6 h-6 bg-primary text-primary-foreground text-xs font-bold rounded-full flex items-center justify-center">2</span>
          </div>
          <h3 class="text-base font-semibold text-foreground mb-2">Promotor acepta</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Un promotor disponible en la zona ve la visita y la acepta desde su app, modelo bajo demanda.
          </p>
        </CardContent>
      </Card>

      <!-- Connector -->
      <div class="hidden md:flex items-center justify-center px-3 text-border flex-shrink-0" aria-hidden="true">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </div>
      <div class="flex md:hidden items-center justify-center text-border -my-1" aria-hidden="true">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
        </svg>
      </div>

      <!-- Step 3 -->
      <Card
        className="flex-1 py-0 bg-card border border-border hover:border-primary/30 hover:shadow-sm transition-all duration-200"
        data-animate data-delay="300"
      >
        <CardContent className="flex flex-col items-center text-center p-8">
          <div class="relative w-14 h-14 bg-primary/10 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <span class="absolute -top-2 -right-2 w-6 h-6 bg-primary text-primary-foreground text-xs font-bold rounded-full flex items-center justify-center">3</span>
          </div>
          <h3 class="text-base font-semibold text-foreground mb-2">Ejecución y seguimiento</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            El promotor realiza la visita y el cliente recibe actualizaciones en tiempo real con evidencias.
          </p>
        </CardContent>
      </Card>

    </div>
  </div>
</section>
