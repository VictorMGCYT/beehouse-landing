---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Hero from "../components/Hero.astro";
import HowItWorksNew from "../components/HowItWorksNew.astro";
import ForBrands from "../components/ForBrands.astro";
import ForPromoters from "../components/ForPromoters.astro";
import Features from "../components/Features.astro";
import CTAFinal from "../components/CTAFinal.astro";
import Footer from "../components/Footer.astro";
import HeroNew from "@/components/HeroNew.astro";
import HoneycombDivider from "@/components/HoneycombDivider.astro";
---

<Layout>
  <Navbar client:load />
  <main>
    <HeroNew />
    <HoneycombDivider seed={3} rows={3} class="bg-muted" />
    <HowItWorksNew />
    <ForBrands />
    <ForPromoters />
    <Features />
    <CTAFinal />
  </main>
  <Footer />
</Layout>
