---
/**
 * Divisor de panal estilo 2D: celdas hexagonales con miel, bordes de cera
 * y un borde inferior irregular. Mismo `seed` => mismo dibujo.
 *
 * Uso:
 *   <HoneycombDivider />
 *   <HoneycombDivider seed={4} size={40} flip />
 */
interface Props {
  /** Cambia qué celdas aparecen en el borde irregular */
  seed?: number;
  /** Radio de cada hexágono en px */
  size?: number;
  /** Filas completas antes del borde irregular */
  rows?: number;
  /** Voltea verticalmente (borde irregular hacia arriba) */
  flip?: boolean;
  /** Destellos que brillan suavemente */
  animated?: boolean;
  colors?: { wax: string; honey: string; light: string; glint: string };
  class?: string;
}

const {
  seed = 1,
  size = 40,
  rows = 2,
  flip = false,
  animated = true,
  colors = {
    wax: "#fde3a0",
    honey: "#f6a821",
    light: "#ffc94d",
    glint: "#fff9e6",
  },
  class: className,
} = Astro.props;

// Ancho fijo: se centra y recorta a los lados, así nunca se deforma.
const W = 3560;
const r = size;
const hw = Math.sqrt(3) * r; // ancho de un hexágono (punta arriba)
const rowH = 1.5 * r;

// PRNG determinista (mulberry32)
function rng(s: number) {
  let a = s >>> 0 || 1;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(seed);
const n = (v: number) => v.toFixed(1);

// --- Rejilla -----------------------------------------------------------
// Fila 0 centrada en y=0 (queda cortada a la mitad, como si siguiera arriba).
// Filas 0..rows-1 completas; después dos filas irregulares que solo
// aparecen si tienen al menos una celda arriba que las sostenga.
const cols = Math.ceil(W / hw) + 1;
const key = (c: number, row: number) => `${c},${row}`;
const present = new Set<string>();

const totalRows = rows + 2;
for (let row = 0; row < totalRows; row++) {
  const odd = row % 2 === 1;
  const chance = row < rows ? 1 : row === rows ? 0.5 : 0.22;
  for (let c = -1; c < cols; c++) {
    if (row >= rows) {
      // Vecinos de arriba en una rejilla desplazada
      const parents = odd
        ? [key(c, row - 1), key(c + 1, row - 1)]
        : [key(c - 1, row - 1), key(c, row - 1)];
      if (!parents.some((p) => present.has(p))) continue;
      if (rand() > chance) continue;
    }
    present.add(key(c, row));
  }
}

type Cell = { x: number; y: number; glint: boolean; g: number };
const cells: Cell[] = [...present].map((k) => {
  const [c, row] = k.split(",").map(Number);
  return {
    x: c * hw + (row % 2 === 1 ? hw / 2 : 0),
    y: row * rowH,
    glint: rand() > 0.3,
    g: 0.8 + rand() * 0.4, // variación de tamaño del destello
  };
});

const maxY = Math.max(...cells.map((c) => c.y));
const H = Math.ceil(maxY + r + 8);

// Hexágono con punta arriba
function hex(cx: number, cy: number, rad: number) {
  const pts = [];
  for (let i = 0; i < 6; i++) {
    const a = (Math.PI / 180) * (60 * i - 90);
    pts.push(`${n(cx + rad * Math.cos(a))},${n(cy + rad * Math.sin(a))}`);
  }
  return pts.join(" ");
}

const gap = r * 0.09; // grosor de la cera entre celdas
const round = r * 0.14; // redondeo de las esquinas de la miel
const inner = r - gap - round;
---

<div
  class:list={[
    "pointer-events-none relative w-full overflow-hidden",
    className,
  ]}
  style={`height: ${H}px; ${flip ? "transform: scaleY(-1);" : ""}`}
  aria-hidden="true"
>
  <svg
    class="absolute top-0 left-1/2 -translate-x-1/2"
    width={W}
    height={H}
    viewBox={`0 0 ${W} ${H}`}
  >
    <!-- Cera: celdas a tamaño completo (se unen sin huecos) con borde redondeado -->
    <g
      fill={colors.wax}
      stroke={colors.wax}
      stroke-width={n(r * 0.16)}
      stroke-linejoin="round"
    >
      {cells.map((c) => (
        <polygon points={hex(c.x, c.y, r)} />
      ))}
    </g>

    <!-- Miel: tono claro (borde iluminado arriba-izquierda) -->
    <g
      fill={colors.light}
      stroke={colors.light}
      stroke-width={n(round * 2)}
      stroke-linejoin="round"
    >
      {cells.map((c) => (
        <polygon points={hex(c.x, c.y, inner)} />
      ))}
    </g>

    <!-- Miel: tono base, un poco más chica y desplazada abajo-derecha -->
    <g
      fill={colors.honey}
      stroke={colors.honey}
      stroke-width={n(round * 2)}
      stroke-linejoin="round"
    >
      {cells.map((c) => (
        <polygon points={hex(c.x + r * 0.035, c.y + r * 0.06, inner * 0.9)} />
      ))}
    </g>

    <!-- Destellos -->
    <g fill={colors.glint}>
      {cells
        .filter((c) => c.glint)
        .map((c, i) => {
          const gx = c.x + r * 0.42;
          const gy = c.y - r * 0.28;
          return (
            <g
              class:list={[animated && "glint"]}
              style={`--delay: -${((i * 0.73) % 6).toFixed(2)}s`}
            >
              <rect
                x={n(gx - r * 0.05 * c.g)}
                y={n(gy - r * 0.2 * c.g)}
                width={n(r * 0.1 * c.g)}
                height={n(r * 0.4 * c.g)}
                rx={n(r * 0.05 * c.g)}
                transform={`rotate(30 ${n(gx)} ${n(gy)})`}
              />
              <circle
                cx={n(c.x + r * 0.2)}
                cy={n(c.y - r * 0.5)}
                r={n(r * 0.05 * c.g)}
              />
            </g>
          );
        })}
    </g>
  </svg>
</div>

<style>
  .glint {
    animation: twinkle 6s ease-in-out var(--delay) infinite;
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glint {
      animation: none;
    }
  }
</style>
